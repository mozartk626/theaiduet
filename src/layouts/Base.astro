---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishDate?: Date;
}

const {
  title,
  description = 'Field notes and conversations from the AI frontier in Singapore. Where Chinese AI meets the world.',
  ogImage,
  article = false,
  publishDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'The AI Duet';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <title>{title === 'Home' ? `${siteName} — Where Chinese AI meets the world` : `${title} — ${siteName}`}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Ellen" />

  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
  {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />}

  <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

  {article && publishDate && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": publishDate.toISOString(),
      "author": { "@type": "Person", "name": "Ellen" },
      "publisher": { "@type": "Organization", "name": siteName }
    })} />
  )}
</head>

<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="brand">The AI <span>Duet</span></a>
      <div class="nav-links">
        <a href="/posts">Field Notes</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/chinese">中文</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-nav">
        <a href="/">Home</a>
        <a href="/posts">Field Notes</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/chinese">中文</a>
        <a href="/rss.xml">RSS</a>
      </div>
      <div class="footer-contact">
        <a href="mailto:ellen@theaiduet.com">ellen@theaiduet.com</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,249,247,0.92);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width); margin: 0 auto;
    padding: 0 var(--spacing-page); height: 60px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .brand {
    font-family: var(--font-mono); font-size: 16px; font-weight: 500;
    letter-spacing: -0.3px; color: var(--color-text); text-decoration: none;
  }
  .brand:hover { opacity: 1; }
  .brand span { color: var(--color-accent); }
  .nav-links { display: flex; gap: 28px; align-items: center; }
  .nav-links a {
    font-size: 14px; font-weight: 500;
    color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--color-text); opacity: 1; }

  .site-footer {
    max-width: var(--max-width); margin: 0 auto;
    padding: 48px var(--spacing-page);
    border-top: 1px solid var(--color-border);
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-inner {
    width: 100%; display: flex;
    justify-content: space-between; align-items: center;
  }
  .footer-nav { display: flex; gap: 24px; }
  .footer-nav a { font-size: 13px; color: var(--color-text-secondary); text-decoration: none; }
  .footer-nav a:hover { color: var(--color-text); opacity: 1; }
  .footer-contact a { font-size: 13px; color: var(--color-text-secondary); text-decoration: none; }
  .footer-contact a:hover { color: var(--color-accent); opacity: 1; }

  @media (max-width: 768px) {
    .nav-inner { padding: 0 20px; }
    .nav-links { gap: 20px; }
    .site-footer { padding: 40px 20px; }
    .footer-inner { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>
