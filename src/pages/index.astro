---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}
---

<Base title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-main">
      <div class="tagline">Field notes from the AI frontier</div>
      <h1>Where Chinese AI<br>meets the <em>world</em></h1>
      <p class="hero-desc">
        <strong>The AI Duet</strong> is a publication and services studio by <strong>Ellen</strong> — based in Singapore, working at the intersection of China's AI ecosystem and global markets.
      </p>
    </div>
    <div class="hero-side">
      <div class="label">What I do</div>
      <p>I help Chinese AI companies land in Singapore through events, introductions, and ecosystem access. I write about what I learn along the way.</p>
      <a href="/services" class="side-link">See services →</a>
    </div>
  </section>

  <div class="divider"><hr></div>

  <!-- Field Notes -->
  <section class="field-notes">
    <div class="section-header">
      <div class="section-title">Latest Field Notes</div>
      <a href="/posts" class="section-link">View all →</a>
    </div>

    <div class="articles-grid">
      {posts.map((post) => (
        <a href={`/posts/${post.id}`} class="article-card">
          <div>
            <div class="article-meta">
              <span class="article-type">
                {post.data.episode ? `🎙 ${post.data.episodeNumber || 'Podcast'}` : 'Field Note'}
              </span>
              <span class="article-date">{formatDate(post.data.date)}</span>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.titleZh && <div class="zh-title">{post.data.titleZh}</div>}
            <p>{post.data.description}</p>
          </div>
          <div class="article-arrow">→</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Services Strip -->
  <section class="services-strip">
    <div class="services-inner">
      <div class="services-intro">
        <div class="label">Services</div>
        <h2>Your first call in Singapore</h2>
        <p>If you're a Chinese AI company thinking about going global — and Singapore is on your list — I can help you skip the trial-and-error phase.</p>
        <a href="mailto:ellen@theaiduet.com" class="services-cta">Get in touch →</a>
      </div>
      <div class="services-list">
        <div class="service-item">
          <h3>Landing Events</h3>
          <p>Curated 80–100 person events that introduce your company to Singapore's AI ecosystem — investors, government, founders, and press.</p>
        </div>
        <div class="service-item">
          <h3>Resource Matching</h3>
          <p>Direct introductions to EDB, SuperAI, local investors, and ecosystem partners. I connect you to the people who matter.</p>
        </div>
        <div class="service-item">
          <h3>Fundraising Advisory</h3>
          <p>For companies ready to raise — deal positioning, investor introductions, and narrative support for the Singapore and SEA market.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    max-width: var(--max-width); margin: 0 auto;
    padding: 100px var(--spacing-page) 80px;
    display: grid; grid-template-columns: 1fr 340px; gap: 80px; align-items: end;
  }
  .tagline {
    font-family: var(--font-mono); font-size: 13px; font-weight: 400;
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--color-text-secondary); margin-bottom: 32px;
  }
  .hero-main h1 {
    font-family: var(--font-display); font-size: 72px; font-weight: 400;
    line-height: 1.0; letter-spacing: -2px; margin-bottom: 28px;
  }
  .hero-main h1 em { font-style: italic; color: var(--color-accent); }
  .hero-desc { font-size: 18px; line-height: 1.7; color: var(--color-text-secondary); max-width: 520px; }
  .hero-desc strong { color: var(--color-text); font-weight: 600; }
  .hero-side {
    border-left: 1px solid var(--color-border); padding-left: 40px;
  }
  .hero-side .label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-text-secondary); margin-bottom: 16px;
  }
  .hero-side p { font-size: 15px; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: 20px; }
  .side-link {
    font-size: 14px; font-weight: 600; color: var(--color-accent);
    display: inline-flex; align-items: center; gap: 6px; transition: gap 0.2s;
  }
  .side-link:hover { gap: 10px; opacity: 1; }

  .divider { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-page); }
  .divider hr { border: none; border-top: 1px solid var(--color-border); }

  .field-notes { max-width: var(--max-width); margin: 0 auto; padding: 64px var(--spacing-page) 80px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 48px; }
  .section-title {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary);
  }
  .section-link {
    font-size: 14px; font-weight: 600; color: var(--color-accent);
    display: inline-flex; align-items: center; gap: 6px; transition: gap 0.2s;
  }
  .section-link:hover { gap: 10px; opacity: 1; }

  .articles-grid { display: grid; gap: 0; }
  .article-card {
    display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: start;
    padding: 36px 0; border-top: 1px solid var(--color-border);
    text-decoration: none; color: inherit; transition: background 0.2s;
  }
  .article-card:last-child { border-bottom: 1px solid var(--color-border); }
  .article-card:hover {
    background: var(--color-accent-light);
    margin: 0 -16px; padding-left: 16px; padding-right: 16px;
  }
  .article-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .article-type {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent);
  }
  .article-date { font-size: 13px; color: var(--color-text-secondary); }
  .article-card h3 {
    font-family: var(--font-display); font-size: 26px; font-weight: 400;
    line-height: 1.25; letter-spacing: -0.3px; margin-bottom: 10px;
  }
  .zh-title { font-size: 14px; color: var(--color-text-secondary); margin-top: 4px; margin-bottom: 6px; }
  .article-card p { font-size: 15px; line-height: 1.6; color: var(--color-text-secondary); max-width: 580px; }
  .article-arrow {
    font-size: 20px; color: var(--color-text-secondary); padding-top: 12px;
    transition: color 0.2s, transform 0.2s;
  }
  .article-card:hover .article-arrow { color: var(--color-accent); transform: translateX(4px); }

  .services-strip { background: var(--color-text); color: white; padding: 80px var(--spacing-page); margin-top: 20px; }
  .services-inner {
    max-width: var(--max-width); margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
  }
  .services-intro .label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 20px;
  }
  .services-intro h2 {
    font-family: var(--font-display); font-size: 40px; font-weight: 400;
    line-height: 1.15; letter-spacing: -1px; margin-bottom: 20px;
  }
  .services-intro p { font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.6); margin-bottom: 28px; }
  .services-cta {
    display: inline-block; padding: 14px 28px;
    border: 1.5px solid rgba(255,255,255,0.25); border-radius: 6px;
    color: white; font-size: 14px; font-weight: 600; text-decoration: none; transition: all 0.2s;
  }
  .services-cta:hover { border-color: var(--color-accent); background: var(--color-accent); opacity: 1; }
  .services-list { display: flex; flex-direction: column; justify-content: center; }
  .service-item { padding: 28px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .service-item:first-child { border-top: 1px solid rgba(255,255,255,0.1); }
  .service-item h3 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
  .service-item p { font-size: 14px; color: rgba(255,255,255,0.5); line-height: 1.6; }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 48px; padding: 64px 20px 48px; }
    .hero-main h1 { font-size: 44px; letter-spacing: -1px; }
    .hero-side { border-left: none; border-top: 1px solid var(--color-border); padding-left: 0; padding-top: 32px; }
    .field-notes { padding: 48px 20px 64px; }
    .divider { padding: 0 20px; }
    .article-card { grid-template-columns: 1fr; gap: 0; }
    .article-card h3 { font-size: 22px; }
    .article-arrow { display: none; }
    .services-strip { padding: 60px 20px; }
    .services-inner { grid-template-columns: 1fr; gap: 48px; }
    .services-intro h2 { font-size: 32px; }
  }
</style>
