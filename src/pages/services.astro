---
import Base from '../layouts/Base.astro';
---

<Base title="Services" description="Fundraising advisory and landing events for AI entrepreneurs with global ambitions.">
  <section class="services-hero">
    <div class="hero-inner">
      <div class="label">Services</div>
      <h1>For AI entrepreneurs<br>with global ambitions</h1>
      <p class="hero-desc">
        I work with AI founders who are building for global markets. Whether
        you're raising capital or making your first move into a new geography,
        I bring ecosystem access, pattern recognition from working with dozens
        of AI companies, and the ability to bridge Chinese and international contexts.
      </p>
      <a href="mailto:ellen@theaiduet.com" class="hero-cta">Start a conversation →</a>
    </div>
  </section>

  <section class="offerings">
    <div class="offerings-inner">

      <div class="offering">
        <div class="offering-number">01</div>
        <div class="offering-content">
          <h2>Fundraising</h2>
          <p>
            Deal positioning, investor introductions, and narrative support for
            AI startups raising in Singapore, SEA, and global markets. I understand
            how Chinese AI companies are perceived by international investors — and
            how to frame your story so the technology, traction, and market opportunity
            come through clearly.
          </p>
          <div class="offering-details">
            <div class="detail">
              <strong>What you get</strong>
              <span>Investor mapping, positioning strategy, materials review, warm introductions, and ongoing advisory through close</span>
            </div>
            <div class="detail">
              <strong>Who it's for</strong>
              <span>AI companies with product-market fit ready to raise from international investors</span>
            </div>
          </div>
        </div>
      </div>

      <div class="offering">
        <div class="offering-number">02</div>
        <div class="offering-content">
          <h2>Landing Events & Growth Consulting</h2>
          <p>
            Curated events that introduce your company to the ecosystem that matters —
            investors, government agencies, potential partners, and press. Not generic
            networking; designed around your company's specific positioning and growth stage.
            Combined with go-to-market consulting for entering new markets through Singapore.
          </p>
          <div class="offering-details">
            <div class="detail">
              <strong>What you get</strong>
              <span>Event design and execution, guest curation, go-to-market strategy, ecosystem introductions, and post-event follow-through</span>
            </div>
            <div class="detail">
              <strong>Who it's for</strong>
              <span>AI companies making their move into Singapore or using it as a springboard into broader markets</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="services-cta-section">
    <div class="cta-inner">
      <h2>Let's talk</h2>
      <p>Every engagement starts with a conversation. Tell me where you are, where you want to go, and what's in the way.</p>
      <a href="mailto:ellen@theaiduet.com" class="cta-btn">ellen@theaiduet.com →</a>
    </div>
  </section>
</Base>

<style>
  .services-hero {
    padding: 100px var(--spacing-page) 80px;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner { max-width: var(--prose-width); margin: 0 auto; }
  .hero-inner .label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-accent); margin-bottom: 24px;
  }
  .services-hero h1 {
    font-family: var(--font-display); font-size: 52px; font-weight: 400;
    line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 24px;
  }
  .hero-desc {
    font-size: 18px; line-height: 1.7; color: var(--color-text-secondary);
    margin-bottom: 32px;
  }
  .hero-cta {
    display: inline-block; padding: 14px 28px;
    background: var(--color-text); color: var(--color-bg);
    font-size: 14px; font-weight: 600; border-radius: 6px;
    text-decoration: none; transition: background 0.2s;
  }
  .hero-cta:hover { background: var(--color-accent); opacity: 1; }

  .offerings { padding: 80px var(--spacing-page); }
  .offerings-inner { max-width: 900px; margin: 0 auto; }
  .offering {
    display: grid; grid-template-columns: 60px 1fr; gap: 24px;
    padding: 48px 0; border-top: 1px solid var(--color-border);
  }
  .offering:last-child { border-bottom: 1px solid var(--color-border); }
  .offering-number {
    font-family: var(--font-mono); font-size: 13px; font-weight: 500;
    color: var(--color-accent); padding-top: 4px;
  }
  .offering-content h2 {
    font-family: var(--font-display); font-size: 28px; font-weight: 400;
    margin-bottom: 16px;
  }
  .offering-content > p {
    font-size: 16px; line-height: 1.8; color: var(--color-text-secondary);
    margin-bottom: 24px;
  }
  .offering-details { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .detail strong {
    display: block; font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.05em;
    margin-bottom: 4px; color: var(--color-text);
  }
  .detail span { font-size: 14px; line-height: 1.6; color: var(--color-text-secondary); }

  .services-cta-section { padding: 80px var(--spacing-page); text-align: center; }
  .cta-inner { max-width: 480px; margin: 0 auto; }
  .cta-inner h2 {
    font-family: var(--font-display); font-size: 32px; font-weight: 400;
    margin-bottom: 12px;
  }
  .cta-inner p { font-size: 16px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 28px; }
  .cta-btn {
    display: inline-block; padding: 14px 28px;
    border: 1.5px solid var(--color-text); border-radius: 6px;
    color: var(--color-text); font-size: 14px; font-weight: 600;
    text-decoration: none; transition: all 0.2s;
  }
  .cta-btn:hover { border-color: var(--color-accent); color: var(--color-accent); opacity: 1; }

  @media (max-width: 768px) {
    .services-hero { padding: 64px 20px 48px; }
    .services-hero h1 { font-size: 36px; }
    .offerings { padding: 48px 20px; }
    .offering { grid-template-columns: 1fr; gap: 8px; }
    .offering-number { padding-top: 0; }
    .offering-details { grid-template-columns: 1fr; }
    .services-cta-section { padding: 60px 20px; }
  }
</style>
