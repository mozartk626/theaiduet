---
import Base from '../layouts/Base.astro';
---

<Base title="中文内容" description="离线时间中文播客和内容入口 — 小宇宙、微信公众号、小红书。">
  <section class="page">
    <div class="page-inner">
      <h1 class="page-title">中文内容</h1>
      <p class="page-subtitle">
        The AI Duet originates from <strong>离线时间</strong>, a Chinese-language podcast.
        Here's where to find the original content.
      </p>

      <div class="channels">
        <a href="https://www.xiaoyuzhoufm.com/podcast/YOUR_ID" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">🎙</div>
          <div class="channel-info">
            <h3>小宇宙 Xiaoyuzhou</h3>
            <p>Our primary podcast home — weekly episodes with AI founders.</p>
          </div>
          <span class="channel-arrow">→</span>
        </a>

        <a href="#" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">🍎</div>
          <div class="channel-info">
            <h3>Apple Podcasts</h3>
            <p>Subscribe on Apple Podcasts.</p>
          </div>
          <span class="channel-arrow">→</span>
        </a>

        <a href="#" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">📱</div>
          <div class="channel-info">
            <h3>微信公众号</h3>
            <p>Long-form articles and episode deep-dives. Search: 离线时间</p>
          </div>
          <span class="channel-arrow">→</span>
        </a>

        <a href="https://www.xiaohongshu.com/user/profile/YOUR_ID" target="_blank" rel="noopener" class="channel-card">
          <div class="channel-icon">📕</div>
          <div class="channel-info">
            <h3>小红书 Xiaohongshu</h3>
            <p>Bite-sized insights and community updates.</p>
          </div>
          <span class="channel-arrow">→</span>
        </a>
      </div>

      <div class="note">
        <p>
          If you speak Chinese, you'll get the most out of the original podcast — the English
          articles here are adapted versions with additional context for an international audience.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page { padding: 80px var(--spacing-page); }
  .page-inner { max-width: var(--prose-width); margin: 0 auto; }
  .page-title {
    font-family: var(--font-display); font-size: 44px; font-weight: 400;
  }
  .page-subtitle {
    margin-top: 16px; font-size: 17px; line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .page-subtitle strong { color: var(--color-text); font-weight: 600; }
  .channels { margin-top: 40px; }
  .channel-card {
    display: flex; align-items: center; gap: 20px;
    padding: 24px 0; border-top: 1px solid var(--color-border);
    color: var(--color-text); text-decoration: none;
  }
  .channel-card:last-child { border-bottom: 1px solid var(--color-border); }
  .channel-card:hover { opacity: 1; }
  .channel-card:hover .channel-arrow { transform: translateX(4px); color: var(--color-accent); }
  .channel-icon { font-size: 24px; flex-shrink: 0; width: 40px; text-align: center; }
  .channel-info { flex: 1; }
  .channel-info h3 {
    font-family: var(--font-display); font-size: 20px; font-weight: 400;
  }
  .channel-info p { margin-top: 4px; font-size: 14px; color: var(--color-text-secondary); }
  .channel-arrow {
    font-size: 18px; color: var(--color-text-secondary); flex-shrink: 0;
    transition: transform 0.2s, color 0.2s;
  }
  .note {
    margin-top: 48px; padding: 24px 28px;
    background: var(--color-accent-light); border-radius: 8px;
    border-left: 3px solid var(--color-accent);
  }
  .note p { font-size: 15px; line-height: 1.7; color: var(--color-text-secondary); }
  @media (max-width: 768px) {
    .page { padding: 48px 20px; }
    .page-title { font-size: 32px; }
  }
</style>
